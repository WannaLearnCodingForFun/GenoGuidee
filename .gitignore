# Research data: never commit datasets — commit manifests, scripts, checksums instead
research/data/raw/
research/data/interim/
research/data/processed/
research/data/external_holdout/

# Model weights: registry metadata is committed, binary artifacts are not
models/pretrained/
models/checkpoints/
models/production/*.bin
models/production/*.pt
models/production/*.ubj

# Small legacy demo model stays committed for reproducibility of the demo;
# new large artifacts must not be committed.

# OS / editor
.DS_Store
*.log
.env
.env.*
