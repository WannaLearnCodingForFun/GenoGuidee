# Copy to .env (never commit secrets).

# --- Database ---
# SQLite by default. Set a Postgres URL when you promote the clinical store.
DATABASE_URL=sqlite:///backend/app/clinical.db
GENOGUIDE_CLINICAL_DB=backend/app/clinical.db
GENOGUIDE_SECRET_KEY=change-me-in-any-shared-environment

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional Supabase (leave unset for local password accounts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- ML ---
ML_MODEL_PATH=models/production/logreg_gene_disjoint.joblib
ESM_MODEL_NAME=esm2_t6_8M_UR50D
# live ESM-2 requires fair-esm + torch and GENOGUIDE_MODE=live
GENOGUIDE_MODE=demo

# --- Therapy ranking (do not hardcode a session ngrok hostname) ---
GENOGUIDE_DRUG_LOCAL=true
THERAPY_API_BASE_URL=
THERAPY_API_KEY=
GENOGUIDE_DRUG_API_URL=
GENOGUIDE_DRUG_API_ENABLED=false
GENOGUIDE_DRUG_API_TIMEOUT=8
NGROK_URL=
GENOGUIDE_NGROK=
GENOGUIDE_NGROK_URL=
GENOGUIDE_PUBLIC_URL=

# --- Optional CORS / tunnel ---
GENOGUIDE_CORS_ORIGINS=
NEXT_PUBLIC_GENOGUIDE_TUNNEL_KEY=
GENOGUIDE_FRONTEND_SHARED_KEY=
