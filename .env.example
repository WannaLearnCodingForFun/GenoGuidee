# Copy to .env (never commit secrets).

# --- Database ---
# SQLite by default. Set a Postgres URL when you promote the clinical store.
DATABASE_URL=sqlite:///backend/app/clinical.db
GENOGUIDE_CLINICAL_DB=backend/app/clinical.db
GENOGUIDE_SECRET_KEY=change-me-in-any-shared-environment

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# Additive platform screens (legacy routes ignore these)
NEXT_PUBLIC_ENABLE_PLATFORM_FEATURES=true
NEXT_PUBLIC_ENABLE_REANALYSIS=true
NEXT_PUBLIC_ENABLE_CURATION=true
NEXT_PUBLIC_ENABLE_ACMG_SIMULATOR=true
NEXT_PUBLIC_ENABLE_PHENOPACKETS=true
NEXT_PUBLIC_ENABLE_MODEL_MONITORING=true

# Optional Supabase (leave unset for local password accounts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- ML ---
ML_MODEL_PATH=models/production/logreg_gene_disjoint.joblib
ESM_MODEL_NAME=esm2_t6_8M_UR50D
# live ESM-2 requires fair-esm + torch and GENOGUIDE_MODE=live
GENOGUIDE_MODE=demo

# --- Therapy ranking (do not hardcode a session ngrok hostname) ---
GENOGUIDE_DRUG_LOCAL=true
THERAPY_API_BASE_URL=
THERAPY_API_KEY=
GENOGUIDE_DRUG_API_URL=
GENOGUIDE_DRUG_API_ENABLED=false
GENOGUIDE_DRUG_API_TIMEOUT=8
NGROK_URL=
GENOGUIDE_NGROK=
GENOGUIDE_NGROK_URL=
GENOGUIDE_PUBLIC_URL=

# --- Optional CORS / tunnel ---
GENOGUIDE_CORS_ORIGINS=
NEXT_PUBLIC_GENOGUIDE_TUNNEL_KEY=
GENOGUIDE_FRONTEND_SHARED_KEY=

# --- Continuous interpretation (existing APIs ignore these) ---
ENABLE_REANALYSIS=true
ENABLE_EVIDENCE_GRAPH=true
ENABLE_HUMAN_REVIEW=true
ENABLE_PHENOPACKET=true
ENABLE_INHERITANCE_SOLVER=true
ENABLE_VARIANT_SIMULATOR=true
ENABLE_COHORT_MODE=false
ENABLE_MODEL_MONITORING=true
ENABLE_INTERPRETATION_VERSIONING=true
ENABLE_WATCHLIST=true
ENABLE_PHENOTYPE_ENGINE=true
ENABLE_EXPLANATION=true
ENABLE_PROVENANCE_UPGRADE=true
ENABLE_EVIDENCE_TIMELINE=true
